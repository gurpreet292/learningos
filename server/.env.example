PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/learningos
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
NODE_ENV=development

# Optional: configure both values to seed the first admin account.
ADMIN_NAME=LearningOS Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password